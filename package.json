{
  "name": "nlb-seat-booking-extension",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "vite build --watch",
    "package": "npm run build && node scripts/package-extension.mjs",
    "seat-plans:audit": "node scripts/seat-plan-audit.mjs",
    "seat-plans:capture": "node scripts/seat-plan-capture.mjs",
    "seat-plans:prepare": "node scripts/seat-plan-prepare.mjs",
    "seat-plans:verify": "node scripts/seat-plan-verify.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
