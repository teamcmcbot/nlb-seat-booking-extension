{
  "manifest_version": 3,
  "name": "NLB Seat Helper",
  "description": "A clearer interface for NLB seat availability and booking.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nlb.gov.sg/seatbooking/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
