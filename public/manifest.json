{
  "manifest_version": 3,
  "name": "Library Seats SG - for NLB",
  "description": "Find favourite seats, check availability, and book multiple NLB sessions with clear review and confirmation.",
  "version": "1.3.2",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nlb.gov.sg/seatbooking/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
